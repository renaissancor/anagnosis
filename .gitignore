# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────────────────────
dist/
build/
out/

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# ── OS artifacts ──────────────────────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ── IDE ───────────────────────────────────────────────────────────────────────
# JetBrains (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.iws
*.ipr
.idea_modules/

# VS Code
.vscode/
*.code-workspace

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/*
!.claude/agents/
.omc/
.mcp.json

# ── DuckDB ────────────────────────────────────────────────────────────────────
*.db
*.db.wal

# ── Generated data outputs (regenerate with `npm run make:all`) ───────────────
# data/ is generated from csvs/*.csv (the source of truth). Hand-curated history
# panels live in panels/ (tracked). Only the two
# hand-authored files below are tracked.
data/*
!data/index.js
!data/README.md

# ── Third-party downloads (see docs/model/source.md) ─────────────────────────
sources/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.orig
*.bak
*.tmp
.cache/
